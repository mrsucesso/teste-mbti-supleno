{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "supleno.integracao.v1/captura.response",
  "title": "Captura Supleno — response v1",
  "version": "1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "status", "submission_id"],
  "properties": {
    "contract": {"const": "supleno.integracao.v1"},
    "status": {"enum": ["accepted", "duplicate", "suppressed", "rejected", "error"]},
    "submission_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "error": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}},
    "sequence_state": {"enum": ["pending", "sending", "sent", "uncertain", "opt_out"]},
    "retryable": {"type": "boolean"}
  }
}
